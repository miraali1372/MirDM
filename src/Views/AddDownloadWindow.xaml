<Window x:Class="MirDM.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Download — MirDM"
        Width="580" Height="435"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0D1117"
        Foreground="#F0F6FC">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#30363D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="55" />
            </Grid.RowDefinitions>

            <!-- TitleBar -->
            <Grid Grid.Row="0" Background="#161B22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add New Download" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F6FC" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="✕" FontSize="11" Foreground="#8B949E" />
                </Button>
            </Grid>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="22,16,22,10">
                <!-- URL Field -->
                <TextBlock Text="Download URL:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6" />
                <TextBox x:Name="UrlTextBox" TextChanged="UrlTextBox_TextChanged" Height="34" FontSize="12.5" />

                <!-- Save As Directory -->
                <TextBlock Text="Save Directory:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" Margin="0,14,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SaveDirTextBox" Height="34" FontSize="12.5" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ToolButton}" Height="34" Width="80" Click="BrowseFolder_Click" />
                </Grid>

                <!-- Filename override & Connections -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="File Name (optional):" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6" />
                        <TextBox x:Name="FileNameTextBox" Height="34" FontSize="12.5" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Connections:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6" />
                        <ComboBox x:Name="ConnectionsComboBox" Height="34" Background="#161B22" Foreground="#F0F6FC" FontSize="12.5" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="⚡ Auto (Dynamic Concurrency)" IsSelected="True" />
                            <ComboBoxItem Content="4 Connections" />
                            <ComboBoxItem Content="8 Connections" />
                            <ComboBoxItem Content="16 Connections (Fast)" />
                            <ComboBoxItem Content="24 Connections" />
                            <ComboBoxItem Content="32 Connections (Turbo)" />
                            <ComboBoxItem Content="64 Connections (Extreme)" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Alternate Mirrors / CDN Sources -->
                <TextBlock Text="CDN Mirrors / Alternate Sources (Optional, comma-separated):" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" Margin="0,14,0,6" />
                <TextBox x:Name="MirrorsTextBox" Height="34" FontSize="12" ToolTip="Multi-Source download: Add CDN mirror URLs for the same file to pool multi-provider bandwidth simultaneously." />

                <CheckBox x:Name="StartImmediatelyCheck" Content="Start download immediately" IsChecked="True" Foreground="#F0F6FC" Margin="0,16,0,0" VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Bottom Action Buttons -->
            <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <Button Content="📋 Batch / Wildcard..." Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Click="OpenBatch_Click" ToolTip="Open Batch &amp; Asterisk Wildcard Generator" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource ToolButton}" Width="85" Margin="0,0,10,0" Click="CancelButton_Click" />
                        <Button x:Name="StartButton" Content="Start Download" Style="{StaticResource PrimaryButton}" Width="135" Click="StartButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
