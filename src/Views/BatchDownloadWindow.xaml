<Window x:Class="MirDM.Views.BatchDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Batch Download — MirDM"
        Width="860" Height="680"
        MinWidth="750" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="#0D1117"
        Foreground="#F0F6FC">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#30363D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: TitleBar -->
                <RowDefinition Height="36" />
                <!-- 1: Mode Tabs (Multi-URL or Wildcard Pattern) -->
                <RowDefinition Height="Auto" />
                <!-- 2: Preview Header & Selection Actions -->
                <RowDefinition Height="38" />
                <!-- 3: Preview DataGrid -->
                <RowDefinition Height="*" />
                <!-- 4: Save Folder & Concurrency Options -->
                <RowDefinition Height="Auto" />
                <!-- 5: Bottom Action Buttons -->
                <RowDefinition Height="55" />
            </Grid.RowDefinitions>

            <!-- 0. TitleBar -->
            <Grid Grid.Row="0" Background="#161B22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add Batch Download &amp; Wildcard Generator" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F6FC" VerticalAlignment="Center" />
                    <TextBlock Text=" — دانلود دسته‌ای و الگوی ستاره" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="10" Foreground="#8B949E" />
                    </Button>
                    <Button x:Name="MaximizeBtn" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" ToolTip="Maximize / Restore">
                        <TextBlock x:Name="MaximizeGlyph" Text="🗖" FontSize="11" Foreground="#8B949E" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Mode Tabs -->
            <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,10">
                <TabControl x:Name="ModeTabControl" SelectionChanged="ModeTabControl_SelectionChanged">
                    <!-- Mode A: Multi-URL Paste / Text List -->
                    <TabItem Header="📋 Multi-URL Text List (ورودی متنی لینک‌ها)">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Paste multiple URLs below (one URL per line). Empty lines and extra spaces are stripped automatically:"
                                       FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,6" />

                            <TextBox x:Name="UrlsTextBox"
                                     Height="105"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Segoe UI"
                                     FontSize="12"
                                     TextChanged="UrlsTextBox_TextChanged" />

                            <Grid Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetectedCountTextBlock"
                                               Text="✔ Detected: 0 valid links"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="#58A6FF"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📋 Paste Clipboard" Style="{StaticResource ToolButton}" Padding="10,5" Margin="0,0,8,0" Click="PasteClipboard_Click" />
                                    <Button Content="🧹 Clear Text" Style="{StaticResource ToolButton}" Padding="10,5" Click="ClearText_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- Mode B: Asterisk / Wildcard Pattern Generator -->
                    <TabItem Header="⚡ Wildcard Pattern Generator (الگوی ستاره مانند IDM)">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Use * or (*) in the URL as a placeholder for numeric sequences (e.g. https://cdn.site.com/part_*.rar or ep_(*).mp4):"
                                       FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,6" />

                            <!-- Pattern URL -->
                            <TextBox x:Name="PatternUrlTextBox"
                                     Height="32"
                                     FontSize="12"
                                     FontFamily="Consolas, Segoe UI"
                                     TextChanged="PatternInputs_Changed" />

                            <!-- Range & Digits Row -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- From Number -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="From:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="FromTextBox" Width="65" Height="30" Text="1" TextAlignment="Center" TextChanged="PatternInputs_Changed" />
                                </StackPanel>

                                <!-- To Number -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="To:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="ToTextBox" Width="65" Height="30" Text="20" TextAlignment="Center" TextChanged="PatternInputs_Changed" />
                                </StackPanel>

                                <!-- Leading Zeros / Wildcard Size -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Wildcard Size (Leading Zeros):" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="DigitsComboBox" Width="170" Height="30" SelectionChanged="DigitsComboBox_SelectionChanged">
                                        <ComboBoxItem Content="1 (1, 2, 3...)" IsSelected="True" />
                                        <ComboBoxItem Content="2 (01, 02, 03...)" />
                                        <ComboBoxItem Content="3 (001, 002, 003...)" />
                                        <ComboBoxItem Content="4 (0001, 0002...)" />
                                        <ComboBoxItem Content="5 (00001, 00002...)" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Generate Button -->
                                <Button Grid.Column="6" Content="⚡ Generate Preview" Style="{StaticResource PrimaryButton}" Height="30" Padding="14,4" Click="GeneratePattern_Click" />
                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 2. Preview Header & Selection Controls -->
            <Border Grid.Row="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="URLs to Download:" FontWeight="Bold" FontSize="12" Foreground="#F0F6FC" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="PreviewCountTextBlock" Text="(0 selected of 0 total)" FontSize="11.5" Foreground="#58A6FF" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Select All" Style="{StaticResource ToolButton}" Padding="8,4" Margin="0,0,6,0" Click="SelectAll_Click" />
                        <Button Content="Deselect All" Style="{StaticResource ToolButton}" Padding="8,4" Margin="0,0,6,0" Click="DeselectAll_Click" />
                        <Button Content="Invert" Style="{StaticResource ToolButton}" Padding="8,4" Click="InvertSelection_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Preview DataGrid -->
            <Grid Grid.Row="3" Background="#090D13">
                <DataGrid x:Name="PreviewDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          Background="#090D13"
                          RowBackground="#090D13"
                          AlternatingRowBackground="#12171F"
                          BorderThickness="0"
                          Foreground="#F0F6FC"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="32" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1F2836" />
                                    <Setter Property="BorderBrush" Value="#2F81F7" />
                                    <Setter Property="BorderThickness" Value="1,0,0,0" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A212D" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#161B22" />
                            <Setter Property="Foreground" Value="#8B949E" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="BorderBrush" Value="#30363D" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Checkbox Column -->
                        <DataGridTemplateColumn Width="42">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="HeaderCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" Click="HeaderCheckBox_Click" IsChecked="True" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Click="ItemCheckBox_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- # Index -->
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#8B949E" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- File Name -->
                        <DataGridTemplateColumn Header="Target File Name" Width="2*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="📄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11.5" Foreground="#F0F6FC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- URL -->
                        <DataGridTemplateColumn Header="URL" Width="4*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Url}" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Message when no links -->
                <StackPanel x:Name="EmptyPreviewPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="No preview links available" FontSize="14" FontWeight="SemiBold" Foreground="#F0F6FC" HorizontalAlignment="Center" />
                    <TextBlock Text="Paste URLs in Tab 1 or configure a wildcard pattern in Tab 2 to generate preview" FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- 4. Save Folder & Concurrency Options -->
            <Border Grid.Row="4" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,1" Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Save Directory -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Save Directory:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="SaveDirTextBox" Grid.Column="1" Height="32" FontSize="12" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource ToolButton}" Height="32" Width="80" Click="BrowseFolder_Click" />
                    </Grid>

                    <!-- Connections & Immediate Check -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Connections:" FontWeight="SemiBold" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ConnectionsComboBox" Width="200" Height="32">
                                <ComboBoxItem Content="⚡ Auto (Dynamic Concurrency)" IsSelected="True" />
                                <ComboBoxItem Content="4 Connections" />
                                <ComboBoxItem Content="8 Connections" />
                                <ComboBoxItem Content="16 Connections (Fast)" />
                                <ComboBoxItem Content="24 Connections" />
                                <ComboBoxItem Content="32 Connections (Turbo)" />
                                <ComboBoxItem Content="64 Connections (Extreme)" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Grid.Column="1" x:Name="StartImmediatelyCheck" Content="Start downloads immediately (if unchecked, added as Paused / Queued)" IsChecked="False" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 5. Bottom Action Bar -->
            <Border Grid.Row="5" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,0" Padding="18,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource ToolButton}" Width="90" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button x:Name="AddQueueButton" Content="➕ Add All to Queue" Style="{StaticResource PrimaryButton}" MinWidth="160" Height="34" Click="AddQueueButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
